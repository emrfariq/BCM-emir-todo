# Salin nilai dari panel penyedia MySQL ke Environment Variables Vercel.
# Ini template, bukan kredensial asli. Jangan set ENV_FILE di Vercel.
DB_HOST=host-dari-penyedia
DB_PORT=3306
DB_USER=user-dari-penyedia
DB_PASSWORD=password-dari-penyedia
DB_NAME=nama-database-dari-penyedia
DB_CONNECT_TIMEOUT=10
SECRET_KEY=isi-dengan-hasil-secrets-token-hex-32
FLASK_DEBUG=0
# Default: negosiasi TLS. Jika penyedia memerlukan verifikasi sertifikat,
# set DB_SSL_VERIFY=1; DB_SSL_CA dapat menunjuk berkas CA yang disediakan.
# Jangan aktifkan DB_SSL_DISABLED kecuali server memang tidak mendukung TLS.
DB_SSL_DISABLED=0
DB_SSL_CA=
DB_SSL_VERIFY=0
